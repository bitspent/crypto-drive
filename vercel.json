{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": ["iad1"],
  "functions": {
    "src/app/api/og/route.tsx": { "runtime": "nodejs" },
    "src/app/api/webhooks/gumroad/route.ts": { "maxDuration": 30 }
  },
  "redirects": [
    {
      "source": "/module/1",
      "destination": "/track/bitcoin/what-is/satoshi",
      "permanent": true
    },
    {
      "source": "/module/:slug",
      "destination": "/track/bitcoin/what-is/satoshi",
      "permanent": true
    }
  ]
}
