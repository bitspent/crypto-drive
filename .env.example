# Signs practice seeds and certificate hashes. REQUIRED in production:
# `next build` and `next start` refuse to boot without it.
# Generate one with: openssl rand -hex 32
CERT_HASH_SECRET=

# Bitcoin backend: simulated (default, play money), signet (live fees +
# lookups, simulated transfers), or regtest (self-hosted infra, see
# docs/infra-contract.md). Launch target: simulated.
BITCOIN_MODE=simulated
# Self-hosted regtest infra base URL (https, port 443). Regtest only.
INFRA_BASE_URL=https://infra.example.com
# Shared secret the app sends as `Authorization: Bearer` to the infra.
# Regtest only. Generate with: openssl rand -hex 32
INFRA_SHARED_SECRET=change-me
# Admin token for /api/mine (mining blocks so regtest txs confirm).
# Regtest only. Never ships to the browser; required on the
# POST /api/wallet/regtest/mine X-Admin-Token header too.
ADMIN_MINE_TOKEN=change-me

# Postgres connection (Supabase transaction pooler, port 6543, in production).
# When unset, the app falls back to the .data/ file store with a warning —
# local dev only, never deploy like that.
# Local test database: postgres://postgres:postgres@127.0.0.1:5433/postgres
DATABASE_URL=
