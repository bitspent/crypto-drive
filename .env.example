# Signs practice seeds and certificate hashes. REQUIRED in production:
# `next build` and `next start` refuse to boot without it.
# Generate one with: openssl rand -hex 32
CERT_HASH_SECRET=

# Bitcoin backend: simulated (default, play money), signet (live fees +
# lookups, simulated transfers), or regtest (self-hosted infra, see
# docs/infra-contract.md). Launch target: simulated.
BITCOIN_MODE=simulated
# Self-hosted regtest infra base URL (https, port 443). Regtest only.
INFRA_BASE_URL=https://infra.example.com
# Shared secret the app sends as `Authorization: Bearer` to the infra.
# Regtest only. Generate with: openssl rand -hex 32
INFRA_SHARED_SECRET=change-me
# Admin token for /api/mine (mining blocks so regtest txs confirm).
# Regtest only. Never ships to the browser; required on the
# POST /api/wallet/regtest/mine X-Admin-Token header too.
ADMIN_MINE_TOKEN=change-me

# Postgres connection (Supabase transaction pooler, port 6543, in production).
# When unset, the app falls back to the .data/ file store with a warning —
# local dev only, never deploy like that.
# Local test database: postgres://postgres:postgres@127.0.0.1:5433/postgres
DATABASE_URL=

# Gumroad commerce. Product IDs are env-only: real values live in Vercel
# Project Settings and .env.local, never in git.
# Webhook secret: Gumroad Settings → Advanced → Ping; register the Ping URL as
# https://<domain>/api/webhooks/gumroad?secret=<this-value>
GUMROAD_WEBHOOK_SECRET=
GUMROAD_PRODUCT_STARTER=<product-id-from-gumroad>
GUMROAD_PRODUCT_CERTIFIED=<product-id-from-gumroad>
GUMROAD_PRODUCT_VIP=<product-id-from-gumroad>
# Access token for the license verification API fallback on unlock.
# Optional: sent as Bearer when set; the endpoint also answers unauthenticated.
GUMROAD_ACCESS_TOKEN=
# Welcome emails (Resend). Without these, sales still provision; the email
# step logs and continues.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Crypto Drive <hello@yourdomain.com>

# Test harness ONLY: lets CD-DRIVE-* demo keys work on production-mode
# servers (the e2e suite boots `next start`). NEVER set in real production.
# ALLOW_DEMO_LICENSES=1

# Extra demo key honored alongside content/tiers/index.json (deprecated path,
# kept for review builds). Defaults to CD-DRIVE-2026 when unset. Demo keys of
# any kind are rejected in real production (see ALLOW_DEMO_LICENSES above).
# DEMO_LICENSE_KEY=

# --- Public URLs (baked into the client bundle at build time) ---
# The app's own public origin: unlock links in emails, legal contact
# derivation, canonical metadata. Falls back to VERCEL_URL on Vercel.
NEXT_PUBLIC_APP_URL=https://<your-prod-domain>
# Gumroad storefront link (header, home, unlock). Falls back to the
# placeholder below — set the real one before launch.
NEXT_PUBLIC_GUMROAD_URL=<real>
# VIP fulfillment: scheduling link + private Q&A lane. No fallback — the
# course page hides VIP blocks when these are unset.
NEXT_PUBLIC_VIP_CALL_URL=<real>
NEXT_PUBLIC_VIP_QA_URL=<real>

# --- Automatic / harness (not set by hand) ---
# VERCEL_URL, NODE_ENV, and CI are provided by the platform.
# E2E_PORT (default 43127) and E2E_DATABASE_URL select the Playwright target:
# E2E_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
