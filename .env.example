# Copy to .env.local for development. Production values live in Vercel
# Project Settings (Production + Preview) — never in git.

# ─── Bitcoin backend ───────────────────────────────────
# simulated | signet | regtest (launch target: simulated)
BITCOIN_MODE=simulated
# Self-hosted regtest infra (https). Regtest only.
INFRA_BASE_URL=
# Shared secret sent as Authorization: Bearer to the infra. Regtest only.
INFRA_SHARED_SECRET=
# Admin token: regtest mining + the wallet rate-limit bypass header.
ADMIN_MINE_TOKEN=

# ─── Database (required in production) ─────────────────
# Supabase transaction pooler (port 6543). Unset = .data/ file store,
# local dev only — data is lost on redeploy.
DATABASE_URL=

# ─── Crypto (required in production) ───────────────────
# Signs practice seeds and certificate hashes. Generate with:
# openssl rand -hex 32
CERT_HASH_SECRET=
# Pepper for license-key hashing (sha256 at rest). Generate with:
# openssl rand -hex 32
LICENSE_PEPPER=

# ─── Gumroad ───────────────────────────────────────────
# Ping secret: Gumroad Settings → Advanced → Ping. Register the Ping URL as
# https://<domain>/api/webhooks/gumroad?secret=<this-value>
GUMROAD_WEBHOOK_SECRET=
# Product IDs are env-only: real values never in git.
GUMROAD_PRODUCT_STARTER=
GUMROAD_PRODUCT_CERTIFIED=
GUMROAD_PRODUCT_VIP=
# Optional: Bearer for the license-verify fallback (endpoint also answers
# unauthenticated).
GUMROAD_ACCESS_TOKEN=

# ─── Email ─────────────────────────────────────────────
# Welcome emails (Resend). Without these, sales still provision; the email
# step logs and continues.
RESEND_API_KEY=
# Must be a verified sender in Resend, e.g. Crypto Drive <hello@yourdomain.com>
RESEND_FROM_EMAIL=

# ─── Public (baked into the client at build time) ──────
# The app's own public origin: email links, legal contacts, canonicals.
NEXT_PUBLIC_APP_URL=
# Storefront link (header, home, unlock).
NEXT_PUBLIC_GUMROAD_URL=
# VIP fulfillment: scheduling link + private Q&A lane. Unset = VIP blocks hide.
NEXT_PUBLIC_VIP_CALL_URL=
NEXT_PUBLIC_VIP_QA_URL=

# ─── Demo (dev only) ───────────────────────────────────
# Extra demo key honored alongside content/tiers/index.json.
DEMO_LICENSE_KEY=
# Test harness ONLY: lets CD-DRIVE-* work on production-mode servers.
# NEVER set in real production (not even Preview).
# ALLOW_DEMO_LICENSES=1
